  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "build": "npm install --prefix server && npm install --prefix client/Ai-Cold-Mail-Generator && npm run build --prefix client/Ai-Cold-Mail-Generator",
    "start": "npm --prefix server run start",
    "start:server": "npm --prefix server run start",
    "start:client": "npm --prefix client/Ai-Cold-Mail-Generator run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client/Ai-Cold-Mail-Generator run dev"
  },
